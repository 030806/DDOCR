DDOCR_DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/ddocr
DDOCR_DATA_DIR=./data
# YOLOX 推理服务就绪后启用；只接受同一服务器的回环地址。
# DDOCR_YOLOX_URL=http://127.0.0.1:8765
# OCR 默认使用 RapidOCR / ONNX Runtime；如需旧 Paddle 流水线可改为 paddle。
DDOCR_OCR_BACKEND=onnx
# 不设置模型路径时使用 RapidOCR 自带的识别模型，并非项目微调权重。
# 自定义 ONNX 识别模型须与 RapidOCR 的 CTC 输入/输出及字符表兼容；以下两项同时配置。
# DDOCR_OCR_ONNX_REC_MODEL_PATH=/absolute/path/to/terminal_rec.onnx
# DDOCR_OCR_ONNX_REC_KEYS_PATH=/absolute/path/to/rec_keys.txt
# 非法字符自动替换的最小模型序列概率比（合法候选 / 原始文本）。
DDOCR_OCR_CTC_MIN_RELATIVE_PROBABILITY=0.5
# 光照对照试验可切换 he 或 clahe；完成真实图片评估前保持 none。
DDOCR_OCR_ILLUMINATION=none
# 仅用于本地联调；生产环境必须关闭并接入短信发送服务。
DDOCR_EXPOSE_PASSWORD_RESET_CODE=false

